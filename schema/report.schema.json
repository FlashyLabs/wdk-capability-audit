{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlashyLabs/wdk-capability-audit/blob/main/schema/report.schema.json",
  "title": "wdk-capability-audit report",
  "description": "The machine-readable report produced by @flashylabs/wdk-capability-audit. See README.md and src/report.js. `summary` is always derived from `packages` by buildReport() — a conformant producer must never accept a caller-supplied summary that disagrees with it.",
  "type": "object",
  "required": ["contract", "tool", "generatedAt", "dir", "packages", "summary"],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "wdk-capability-audit-report/1"
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "const": "@flashylabs/wdk-capability-audit" },
        "version": { "type": "string" }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601, when this report was generated."
    },
    "dir": {
      "type": "string",
      "description": "The directory that was scanned."
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "status", "chains"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "status": { "enum": ["inspected", "unrecognized-shape", "unreadable"] },
          "chains": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chain", "classification", "source"],
              "additionalProperties": false,
              "properties": {
                "chain": { "type": "string" },
                "classification": { "enum": ["mainnet", "testnet", "unknown"] },
                "source": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "packagesScanned",
        "packagesInspected",
        "packagesUnrecognizedShape",
        "packagesUnreadable",
        "chainsTotal",
        "chainsByClassification"
      ],
      "additionalProperties": false,
      "properties": {
        "packagesScanned": { "type": "integer" },
        "packagesInspected": { "type": "integer" },
        "packagesUnrecognizedShape": { "type": "integer" },
        "packagesUnreadable": { "type": "integer" },
        "chainsTotal": { "type": "integer" },
        "chainsByClassification": {
          "type": "object",
          "required": ["mainnet", "testnet", "unknown"],
          "additionalProperties": false,
          "properties": {
            "mainnet": { "type": "integer" },
            "testnet": { "type": "integer" },
            "unknown": { "type": "integer" }
          }
        }
      }
    }
  }
}
